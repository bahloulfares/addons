<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue liste -->
    <record id="biblio_livre_view_list" model="ir.ui.view">
        <field name="name">biblio.livre.list</field>
        <field name="model">biblio.livre</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="isbn"/>
                <field name="date_publication"/>
                <field name="nb_pages"/>
                <field name="etat"/>
                <field name="disponible"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="biblio_livre_view_form" model="ir.ui.view">
        <field name="name">biblio.livre.form</field>
        <field name="model">biblio.livre</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="couverture" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Titre du livre"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="isbn"/>
                            <field name="date_publication"/>
                            <field name="nb_pages"/>
                        </group>
                        <group>
                            <field name="etat"/>
                            <field name="disponible"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Résumé">
                            <field name="resume"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue recherche -->
    <record id="biblio_livre_view_search" model="ir.ui.view">
        <field name="name">biblio.livre.search</field>
        <field name="model">biblio.livre</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="isbn"/>
                <filter string="Disponibles" name="disponibles" domain="[('disponible', '=', True)]"/>
                <filter string="Empruntés" name="empruntes" domain="[('disponible', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="État" name="group_etat" context="{'group_by': 'etat'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action fenêtre -->
    <record id="biblio_livre_action" model="ir.actions.act_window">
        <field name="name">Livres</field>
        <field name="res_model">biblio.livre</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ajoutez votre premier livre</p>
        </field>
    </record>

</odoo>